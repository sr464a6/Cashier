{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cashier-system",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-28",

  "assets": {
    "directory": "./cloudflare"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cashier-db",
